{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard"],
  "timezone": "Asia/Taipei",
  "schedule": ["on the first day of the month"],
  "dependencyDashboard": true,
  "dependencyDashboardApproval": false,
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "automerge": true,
  "packageRules": [
    {
      "description": "Ignore patch updates",
      "matchUpdateTypes": ["patch", "digest", "pin"],
      "enabled": false
    },
    {
      "description": "Group all minor and major updates into a single PR and automerge",
      "matchUpdateTypes": ["minor", "major"],
      "groupName": "all dependencies",
      "automerge": true
    },
    {
      "description": "Group Gradle dependencies",
      "matchManagers": ["gradle", "gradle-wrapper"],
      "groupName": "all dependencies"
    },
    {
      "description": "Group Hugo module updates",
      "matchManagers": ["gomod"],
      "groupName": "all dependencies"
    },
    {
      "description": "Group GitHub Actions",
      "matchManagers": ["github-actions"],
      "groupName": "all dependencies"
    },
    {
      "description": "nplus book core updates",
      "matchPackageNames": ["github.com/Andrewnplus/nplus-book-core"],
      "matchDepTypes": ["indirect"],
      "groupName": "all dependencies",
      "enabled": true
    }
  ],
  "gomod": {
    "enabled": true,
    "postUpdateOptions": ["gomodTidy"]
  },
  "regexManagers": [
    {
      "description": "Update Hugo version in GitHub Actions",
      "fileMatch": ["^\\.github/workflows/.*\\.ya?ml$"],
      "matchStrings": ["hugo-version:\\s*['\"]?(?<currentValue>[0-9.]+)['\"]?"],
      "depNameTemplate": "gohugoio/hugo",
      "datasourceTemplate": "github-releases"
    }
  ]
}
