# syntax=docker/dockerfile:1.25
# Custom HugoBook runner: base myoung34 runner + Temurin JDK + Go + Node.
#
# Hugo is deliberately NOT baked in. hugobook-build-deploy.yml runs
# peaceiris/actions-hugo on every job unconditionally, and a binary in
# /usr/local/bin is not in the Actions tool cache, so a baked copy bought no
# speedup — it only shadowed the freshly installed one and tripped that
# workflow's "Verify Hugo version" guard. Keeping the version in exactly one
# place (the hugo-version default in the shared workflow) is what lets Renovate
# automerge Hugo bumps without a coordinated image rebuild.

FROM myoung34/github-runner:2.335.1-ubuntu-noble

ARG JAVA_VERSION=25
# 落後於書 repo go.mod 的 go directive 就會炸：toolchain 自動下載在這些
# container 裡拿不到，所以 baked Go 必須 ≥ Renovate 推上去的版本。書的
# go.mod 進 1.25.3 時 1.24.2 就翻車過一輪（2026-07-26 runner-2 實錄）。
# 「拿不到」的根因是 HiNet DNS 把 proxy.golang.org 劫持到
# safebrowsing.hinet.net（憑證錯誤）——compose 的 dns: 公共 DNS 是第二道
# 防線，版本夠新（不觸發下載）是第一道。
ARG GO_VERSION=1.26.5
ARG NODE_MAJOR=22

USER root

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      curl ca-certificates gnupg wget git && \
    rm -rf /var/lib/apt/lists/*

# Eclipse Temurin JDK (latest LTS per org decision: Java 25)
RUN curl -fsSL https://packages.adoptium.net/artifactory/api/gpg/key/public \
      | gpg --dearmor -o /usr/share/keyrings/adoptium.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/adoptium.gpg] https://packages.adoptium.net/artifactory/deb noble main" \
      > /etc/apt/sources.list.d/adoptium.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends "temurin-${JAVA_VERSION}-jdk" && \
    rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/temurin-${JAVA_VERSION}-jdk-amd64
ENV PATH=$JAVA_HOME/bin:$PATH

# Go (required for Hugo modules — go.sum present in book repos)
RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" \
      -o /tmp/go.tgz && \
    tar -xzf /tmp/go.tgz -C /usr/local && \
    rm /tmp/go.tgz && \
    ln -sf /usr/local/go/bin/go /usr/local/bin/go && \
    ln -sf /usr/local/go/bin/gofmt /usr/local/bin/gofmt && \
    go version

# Node.js (required by Spotless → Prettier for markdown lint)
RUN curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
      | gpg --dearmor -o /usr/share/keyrings/nodesource.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" \
      > /etc/apt/sources.list.d/nodesource.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends nodejs && \
    rm -rf /var/lib/apt/lists/*

# Smoke test: fail build if any tool misbehaves.
# No `hugo version` here — Hugo is installed per job by actions-hugo, not baked in.
RUN java -version && go version && git --version && node --version && npm --version

# Leave entrypoint + USER as set by base image (root → drops to runner internally)
