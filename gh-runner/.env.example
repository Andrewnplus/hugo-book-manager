# ─────────────────────────────────────────────────────────────────────────────
# GitHub self-hosted runner config — copy to .env and fill in.
# .env is gitignored; never commit secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Scope + target org
RUNNER_SCOPE=org
ORG_NAME=nplus-father

# Comma-separated labels; caller workflows target these
LABELS=self-hosted,linux,hugobook

# Org runner group (create in GitHub UI first, or use Default)
RUNNER_GROUP=Default

# Authentication — use a fine-grained PAT, NOT a one-shot registration token.
# Why: EPHEMERAL=true recreates the runner on every job and needs a fresh
# registration token each time. A PAT lets the container auto-mint tokens.
#
# How to create:
#   https://github.com/settings/personal-access-tokens/new
#   - Resource owner: nplus-father
#   - Repository access: All repositories (or restrict later)
#   - Organization permissions → "Self-hosted runners": Read and write
#   - Expiration: 90 days (set a calendar reminder to rotate)
ACCESS_TOKEN=

# Behavior flags
EPHEMERAL=true
DISABLE_AUTO_UPDATE=true
